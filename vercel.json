{
  "rewrites": [
    {
      "source": "/api/whatsapp-webhook",
      "destination": "/api/whatsapp.js"
    },
    {
      "source": "/api/whatsapp",
      "destination": "/api/whatsapp.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?resource=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
