# Vercel server-side environment variables. Never use the service key in VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=SET_IN_VERCEL_ENVIRONMENT_ONLY

# Vite build-time variables (public anon/publishable key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Leave false until SMS/OTP or CAPTCHA and abuse protection are in place.
ENABLE_CUSTOMER_SIGNUP=false
