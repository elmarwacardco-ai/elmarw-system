# Vercel server-side environment variables. Never use the service key in VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=SET_IN_VERCEL_ENVIRONMENT_ONLY

# Vite build-time variables (public anon/publishable key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server-side use of the same public key for password/phone sign-in (never service-role)
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Public Cloudflare Turnstile widget key
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# Secret stays on the server only; registration checks it on every attempt
TURNSTILE_SECRET_KEY=SET_IN_VERCEL_ENVIRONMENT_ONLY

# Keep OFF until the SMS provider, Turnstile, rate limits, migration and end-to-end signup tests are configured.
ENABLE_CUSTOMER_SIGNUP=false
