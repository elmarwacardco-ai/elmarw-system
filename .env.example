# Vercel server-side environment variables. Never use the service key in VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=SET_IN_VERCEL_ENVIRONMENT_ONLY

# Vite build-time variables (public anon/publishable key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server-side use of the same public key for password/phone sign-in (never service-role)
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Public Cloudflare Turnstile widget key
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# Secret stays on the server only; registration checks it on every attempt
TURNSTILE_SECRET_KEY=SET_IN_VERCEL_ENVIRONMENT_ONLY

# Keep OFF until the SMS provider, Turnstile, rate limits, migration and end-to-end signup tests are configured.
ENABLE_CUSTOMER_SIGNUP=false

# Optional preview-only direct PDF uploads (both flags required; default OFF)
# 6 MiB max for standard signed uploads; bigger print jobs need resumable TUS uploads.
ENABLE_DIRECT_PDF_UPLOAD=false
VITE_ENABLE_DIRECT_PDF_UPLOAD=false

# Preview-only WhatsApp draft review: BOTH flags off by default.
# Requires applying and reviewing migration 20261015_whatsapp_drafts.sql.
ENABLE_WHATSAPP_DRAFTS=false
VITE_ENABLE_WHATSAPP_DRAFTS=false

# Preview-only email verification (requires a configured SMTP provider)
# Both feature flags are OFF unless explicitly set to true.
# Registration is protected by Cloudflare Turnstile for both email and SMS.
ENABLE_CUSTOMER_EMAIL_SIGNUP=false
VITE_ENABLE_CUSTOMER_EMAIL_SIGNUP=false
# Optional explicit HTTPS redirect URL (must also be listed in Supabase Auth URL Configuration).
# If unset, use Vercel's trusted VERCEL_URL for the preview deployment.
# CUSTOMER_EMAIL_REDIRECT_URL=https://your-verified-site.example

# Contact-only WhatsApp assistance (NOT authentication):
# VITE_WHATSAPP_BOT_NUMBER=201XXXXXXXXX
